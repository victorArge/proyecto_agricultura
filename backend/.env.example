# Entorno de ejecución: development | production
NODE_ENV=development

# Puerto del servidor Express
PORT=4000

# Origen permitido por CORS (servidor de desarrollo de Vite)
CORS_ORIGIN=http://localhost:5173

# Porcentaje de comisión que cobra la plataforma (se usará en la Etapa 7)
COMMISSION_PERCENT=10

# Conexión a PostgreSQL (Prisma). Sustituye usuario, contraseña, puerto y base de datos.
DATABASE_URL="postgresql://USUARIO:CONTRASENA@localhost:5432/agroforma?schema=public"
